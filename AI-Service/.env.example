# Backend Configuration
BACKEND_URL=http://localhost:3000
DEVICE_SECRET_KEY=your_device_secret_key_here

# Camera Configuration
# For webcam: CAMERA_URL=0 (or 1, 2, 3...)
# For IP camera: CAMERA_URL=rtsp://admin:password@192.168.1.100:554/stream
# For ESP32-CAM: CAMERA_URL=http://192.168.1.x:81/stream
CAMERA_SOURCE=webcam
CAMERA_URL=0

# Cloudinary Configuration (for video upload)
CLOUDINARY_CLOUD_NAME=your_cloud_name
CLOUDINARY_API_KEY=your_api_key
CLOUDINARY_API_SECRET=your_api_secret

# MongoDB Configuration (for face embeddings)
MONGO_URI=mongodb+srv://username:password@cluster.mongodb.net/database?retryWrites=true&w=majority
